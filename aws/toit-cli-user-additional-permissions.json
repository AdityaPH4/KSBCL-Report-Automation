{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["scheduler:CreateSchedule","scheduler:GetSchedule","scheduler:UpdateSchedule","scheduler:DeleteSchedule","scheduler:ListSchedules","scheduler:TagResource"],
      "Resource": "arn:aws:scheduler:ap-south-1:746669213597:schedule/default/robinhood-*"
    },
    {
      "Effect": "Allow",
      "Action": ["iam:CreateRole","iam:GetRole","iam:PutRolePolicy","iam:AttachRolePolicy","iam:TagRole"],
      "Resource": ["arn:aws:iam::746669213597:role/robinhoodCrawlerExecutionRole","arn:aws:iam::746669213597:role/robinhoodSchedulerRole"]
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": ["arn:aws:iam::746669213597:role/robinhoodCrawlerExecutionRole","arn:aws:iam::746669213597:role/robinhoodSchedulerRole"],
      "Condition": {"StringEquals": {"iam:PassedToService": ["ecs-tasks.amazonaws.com","scheduler.amazonaws.com"]}}
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "*",
      "Condition": {"ArnEquals": {"ec2:Vpc": "arn:aws:ec2:ap-south-1:746669213597:vpc/vpc-065647136e489b75f"}}
    },
    {
      "Effect": "Allow",
      "Action": "ec2:AuthorizeSecurityGroupIngress",
      "Resource": "arn:aws:ec2:ap-south-1:746669213597:security-group/*",
      "Condition": {"ArnEquals": {"ec2:Vpc": "arn:aws:ec2:ap-south-1:746669213597:vpc/vpc-065647136e489b75f"}}
    },
    {
      "Effect": "Allow",
      "Action": "ecr:CreateRepository",
      "Resource": "arn:aws:ecr:ap-south-1:746669213597:repository/robinhood-crawlers"
    },
    {
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents","logs:DescribeLogGroups","logs:DescribeLogStreams","logs:GetLogEvents"],
      "Resource": ["arn:aws:logs:ap-south-1:746669213597:log-group:/ecs/robinhood-crawler*","arn:aws:logs:ap-south-1:746669213597:log-group:/ecs/robinhood-crawler*:*"]
    }
  ]
}
