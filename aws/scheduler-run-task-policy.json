{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:ap-south-1:746669213597:task-definition/robinhood-crawler:*",
      "Condition": {
        "ArnEquals": { "ecs:cluster": "arn:aws:ecs:ap-south-1:746669213597:cluster/robinhood" }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::746669213597:role/robinhoodCrawlerExecutionRole"
      ],
      "Condition": {
        "StringLike": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    }
  ]
}
