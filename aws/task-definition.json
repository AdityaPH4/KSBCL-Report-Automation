{
  "family": "robinhood-crawler",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::746669213597:role/robinhoodCrawlerExecutionRole",
  "containerDefinitions": [
    {
      "name": "crawler",
      "image": "746669213597.dkr.ecr.ap-south-1.amazonaws.com/robinhood-crawlers:latest",
      "essential": true,
      "command": ["run_daily_d88_bottles.py"],
      "secrets": [
        { "name": "KSBCL_USERNAME", "valueFrom": "arn:aws:secretsmanager:ap-south-1:746669213597:secret:robinhood/crawler-env:KSBCL_USERNAME::" },
        { "name": "KSBCL_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-south-1:746669213597:secret:robinhood/crawler-env:KSBCL_PASSWORD::" },
        { "name": "KSBCL_CIDER_USERNAME", "valueFrom": "arn:aws:secretsmanager:ap-south-1:746669213597:secret:robinhood/crawler-env:KSBCL_CIDER_USERNAME::" },
        { "name": "KSBCL_CIDER_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-south-1:746669213597:secret:robinhood/crawler-env:KSBCL_CIDER_PASSWORD::" },
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:746669213597:secret:robinhood/crawler-env:DATABASE_URL::" },
        { "name": "GCHAT_WEBHOOK_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:746669213597:secret:robinhood/crawler-env:GCHAT_WEBHOOK_URL::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/robinhood-crawler",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "crawler",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
